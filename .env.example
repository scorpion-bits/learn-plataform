# Copie para .env.local e preencha. Nunca commite valores reais.
# Ver docs/architecture.md §6.

# --- Cliente (públicas; NEXT_PUBLIC_*) ---
# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — pública, a segurança vem de RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base para callbacks/returnUrl (ex.: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# --- Servidor (SECRETAS; nunca prefixar com NEXT_PUBLIC_) ---
# Service role do Supabase (apenas webhook/pagamentos e scripts)
SUPABASE_SECRET_KEY=
# AbacatePay: chave de API (abc_dev_… em dev, abc_prod_… em produção).
# Permissões mínimas: TRANSPARENT:CREATE, TRANSPARENT:READ (+ REFUND:CREATE se reembolsar pela API).
# Sem ela (ou sem o segredo abaixo), o checkout responde "PIX indisponível" sem criar pedido.
ABACATEPAY_API_KEY=
# AbacatePay: segredo na URL do webhook
ABACATEPAY_WEBHOOK_SECRET=
# AbacatePay: URL base da API (opcional; padrão https://api.abacatepay.com/v2).
# Só para apontar o app para o mock dos testes E2E (ADR-021). Aceita https://… ou
# http://localhost|127.0.0.1; é recusada com chave abc_prod_. Não defina em produção.
# ABACATEPAY_API_BASE_URL=http://127.0.0.1:4010/v2
