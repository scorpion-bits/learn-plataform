# Copie para .env.local e preencha. Nunca commite valores reais.
# Ver docs/architecture.md §6.

# --- Cliente (públicas; NEXT_PUBLIC_*) ---
# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — pública, a segurança vem de RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base para callbacks/returnUrl (ex.: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# --- Servidor (SECRETAS; nunca prefixar com NEXT_PUBLIC_) ---
# Service role do Supabase (apenas webhook/pagamentos e scripts)
SUPABASE_SECRET_KEY=
# AbacatePay: chave de API
ABACATEPAY_API_KEY=
# AbacatePay: segredo na URL do webhook
ABACATEPAY_WEBHOOK_SECRET=
# AbacatePay: chave de verificação da assinatura HMAC (confirmar em PAY-001)
ABACATEPAY_WEBHOOK_HMAC_KEY=
